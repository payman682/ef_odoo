<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Job Confirmation (no pricing) -->
    <record id="action_report_job_confirmation" model="ir.actions.report">
      <field name="name">Job Confirmation</field>
      <field name="model">project.task</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">client_equipment.job_confirmation_document</field>
      <field name="report_file">client_equipment.job_confirmation_document</field>
      <!-- Bind into Print menu on task (both Project and Field Service) -->
      <field name="binding_model_id" ref="project.model_project_task"/>
      <field name="binding_type">report</field>
      <field name="print_report_name">'Job Confirmation - %s' % (object.name)</field>
    </record>

  </data>
</odoo>
