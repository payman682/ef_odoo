<odoo>
  <record id="view_client_equipment_manufacturer_tree" model="ir.ui.view">
    <field name="name">client.equipment.manufacturer.tree</field>
    <field name="model">client.equipment.manufacturer</field>
    <field name="arch" type="xml">
      <list>
        <field name="logo" widget="image" options="{'size': [32, 32]}"/>
        <field name="name"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_client_equipment_manufacturer_form" model="ir.ui.view">
    <field name="name">client.equipment.manufacturer.form</field>
    <field name="model">client.equipment.manufacturer</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="logo" widget="image" class="oe_avatar"/>
            <field name="name"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_client_equipment_manufacturer" model="ir.actions.act_window">
    <field name="name">Manufacturers</field>
    <field name="res_model">client.equipment.manufacturer</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
