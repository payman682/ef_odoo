<odoo>
    <!-- Action used by menus.xml for listing technicians.
         In this module, "technicians" are system users, so we bind the action to res.users. -->
    <record id="action_client_equipment_technicians" model="ir.actions.act_window">
        <field name="name">Technicians</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <!-- Optional: keep it broad to avoid breaking on missing groups. You can later add a domain to filter technicians only. -->
        <field name="domain">[('share','=',False)]</field>
        <field name="context">{}</field>
    </record>
</odoo>
