<odoo>
<record id="view_equipment_service_history_list" model="ir.ui.view">
        <field name="name">project.task.equipment.service.history.list</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="client_equipment_id" string="Equipment Name"/>
                <field name="equipment_serial" string="Serial Number"/>
                <field name="partner_id"/>
                <field name="equipment_site"/>
                <field name="service_type"/>
                <field name="stage_id"/>
                <field name="user_ids"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

<record id="action_equipment_service_history" model="ir.actions.act_window">
        <field name="name">Service History</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('client_equipment_id','!=',False)]</field>
                
<field name="context">{'group_by': ['partner_id', 'equipment_site']}</field>
</record>

    <record id="view_equipment_service_history_pivot" model="ir.ui.view">
        <field name="name">project.task.equipment.service.history.pivot</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Service History">
                <field name="partner_id" type="row"/>
                <field name="equipment_site" type="row"/>
                <field name="client_equipment_id" type="row"/>
                <field name="equipment_serial" type="row"/>
                <field name="project_id" type="col"/>
                <field name="service_history_count" type="measure"/>
            </pivot>
        </field>
    </record>

</odoo>
