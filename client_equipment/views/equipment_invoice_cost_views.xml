<odoo>
    <!-- Equipment Cost (Billed): based on posted customer invoices/refunds invoice lines -->

    <!-- SEARCH VIEW -->
    <record id="view_equipment_cost_billed_search" model="ir.ui.view">
        <field name="name">account.move.line.equipment.cost.billed.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search string="Equipment Cost (Billed)">
                <field name="partner_id"/>
                <field name="client_equipment_id"/>
                <field name="product_id"/>
                <field name="ce_cost_bucket"/>

                <filter string="Customer" name="grp_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Equipment" name="grp_equipment" context="{'group_by': 'client_equipment_id'}"/>
                <filter string="Bucket" name="grp_bucket" context="{'group_by': 'ce_cost_bucket'}"/>
                <!-- Use invoice line date (account.move.line.date) for month grouping (avoid move_id.invoice_date) -->
                <filter string="Month" name="grp_month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <!-- LIST VIEW (Odoo 19 uses <list>, not <tree>) -->
    <record id="view_equipment_cost_billed_list" model="ir.ui.view">
        <field name="name">account.move.line.equipment.cost.billed.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Equipment Cost (Billed)" create="false" edit="false" delete="false">
                <field name="move_id"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="client_equipment_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="price_subtotal"/>
                <field name="price_total"/>
                <field name="ce_cost_bucket"/>
                <field name="ce_labor_amount"/>
                <field name="ce_parts_amount"/>
                <field name="ce_labor_total"/>
                <field name="ce_parts_total"/>
            </list>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="view_equipment_cost_billed_pivot" model="ir.ui.view">
        <field name="name">account.move.line.equipment.cost.billed.pivot</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Equipment Cost (Billed)">
                <field name="client_equipment_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="ce_cost_bucket" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="price_total" type="measure"/>
                <field name="ce_labor_amount" type="measure"/>
                <field name="ce_labor_total" type="measure"/>
                <field name="ce_parts_amount" type="measure"/>
                <field name="ce_parts_total" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_equipment_cost_billed" model="ir.actions.act_window">
        <field name="name">Equipment Cost (Billed)</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_equipment_cost_billed_search"/>
        <field name="domain">[("display_type","=",False),("move_id.state","=","posted"),("move_id.move_type","in",("out_invoice","out_refund"))]</field>
        <field name="context">{"search_default_grp_equipment": 1}</field>
    </record>
</odoo>
