<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         Technician - My Service Tasks (project.task)
         ========================================================= -->

    <record id="project_task_search_tech_my_tasks" model="ir.ui.view">
        <field name="name">project.task.search.tech.my.tasks</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Task"/>
                <field name="client_equipment_id" string="Equipment"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_ids" string="Technicians"/>
                <field name="stage_id" string="Stage"/>

                <separator/>

                <filter string="My Tasks" name="my_tasks"
                        domain="[('user_ids', 'in', uid)]"/>
                <filter string="Open" name="open"
                        domain="[('stage_id.fold', '=', False)]"/>
                <filter string="Done" name="done"
                        domain="[('stage_id.fold', '=', True)]"/>
                <filter string="Has Equipment" name="has_equipment"
                        domain="[('client_equipment_id', '!=', False)]"/>

                <separator/>

                <group name="group_by">
                    <filter string="Equipment" name="group_by_equipment"
                            context="{'group_by': 'client_equipment_id'}"/>
                    <filter string="Customer" name="group_by_customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Stage" name="group_by_stage"
                            context="{'group_by': 'stage_id'}"/>
                    <filter string="Technician" name="group_by_user"
                            context="{'group_by': 'user_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="project_task_list_tech_my_tasks" model="ir.ui.view">
        <field name="name">project.task.list.tech.my.tasks</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="client_equipment_id"/>
                <field name="stage_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="date_deadline"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_tech_my_tasks" model="ir.actions.act_window">
        <field name="name">My Service Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_task_search_tech_my_tasks"/>
        <field name="domain">[('user_ids', 'in', uid)]</field>
        <field name="views" eval="[(ref('project_task_list_tech_my_tasks'),'list'), (False,'form')]"/>
        <field name="context">{}</field>
    </record>

    <!-- =========================================================
         Technician - Find Equipment (Scan/Search)
         Model: client.equipment
         ========================================================= -->

    <record id="client_equipment_search_tech" model="ir.ui.view">
        <field name="name">client.equipment.search.tech</field>
        <field name="model">client.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Equipment"/>
                <field name="partner_id" string="Customer"/>
                <field name="serial_number" string="Serial"/>
                <field name="barcode" string="Barcode"/>
                <field name="asset_tag" string="Asset Tag"/>
                <field name="manufacturer_id" string="Manufacturer"/>
                <field name="category_id" string="Category"/>
                <field name="site_contact_id" string="Site"/>

                <separator/>

                <filter string="Active" name="active" domain="[('active','=',True)]"/>

                <group name="group_by">
                    <filter string="Customer" name="group_by_customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Site" name="group_by_site"
                            context="{'group_by': 'site_contact_id'}"/>
                    <filter string="Category" name="group_by_category"
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Manufacturer" name="group_by_manu"
                            context="{'group_by': 'manufacturer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="client_equipment_list_tech" model="ir.ui.view">
        <field name="name">client.equipment.list.tech</field>
        <field name="model">client.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="site_contact_id"/>
                <field name="name"/>
                <field name="manufacturer_id"/>
                <field name="category_id"/>
                <field name="serial_number"/>
                <field name="barcode"/>
                <field name="asset_tag"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_tech_equipment" model="ir.actions.act_window">
        <field name="name">Find Equipment (Scan/Search)</field>
        <field name="res_model">client.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="client_equipment_search_tech"/>
        <field name="views" eval="[(ref('client_equipment_list_tech'),'list'), (False,'form')]"/>
        <field name="context">{}</field>
    </record>

</odoo>
