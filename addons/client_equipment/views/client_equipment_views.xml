<odoo>

  <record id="view_client_equipment_list" model="ir.ui.view">
    <field name="name">client.equipment.list</field>
    <field name="model">client.equipment</field>
    <field name="arch" type="xml">
      <list string="Client Equipment">
        <field name="partner_id"/>
        <field name="site_contact_id" string="Site"/>
        <field name="category_id" string="Category"/>
        <field name="name"/>
        <field name="manufacturer_id" string="Manufacturer"/>
        <field name="model"/>
        <field name="serial_number"/>
        <field name="barcode"/>
        <field name="asset_tag"/>
        <field name="warranty_active"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_client_equipment_form" model="ir.ui.view">
    <field name="name">client.equipment.form</field>
    <field name="model">client.equipment</field>
    <field name="arch" type="xml">
      <form string="Client Equipment">
        <header>
          <button name="action_create_pm_task" type="object" string="Create PM Task" class="btn-primary"/>
          <button name="action_open_maintenance" type="object" string="Maintenance" class="btn-secondary"/>
          <button name="action_create_fsm_task" type="object" string="New Task" class="btn-secondary"/>
        </header>
        <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_task_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="task_attachment_count" widget="statinfo" string="Task Attachments"/>
                        </button>
                    </div>
          <group>
            <group>
              <field name="partner_id"/>
              <field name="site_contact_id"
                     domain="[('id','child_of', partner_id), ('id','!=', partner_id)]"
                     options="{'no_create': True}"/>
              <field name="category_id" string="Category"/>
              <field name="name"/>
              <field name="manufacturer_id" string="Manufacturer"/>
              <field name="manufacturer_logo" widget="image" readonly="1" options="{'size': [64, 64]}"/>
              <field name="model"/>
              <field name="serial_number"/>
              <field name="hour_meter_current"/>
              <field name="needs_attention" widget="boolean_toggle"/>
              <field name="attention_date" invisible="not needs_attention"/>
              <field name="attention_reason" invisible="not needs_attention"/>
              <field name="barcode"/>
              <field name="asset_tag"/>
              <field name="maintenance_project_id"/>
              <field name="active"/>
            </group>

            <group string="Site Address">
              <field name="site_street" readonly="1"/>
              <field name="site_city" readonly="1"/>
              <field name="site_state" readonly="1"/>
              <field name="site_zip" readonly="1"/>
              <field name="site_country_id" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Warranty">
              <group>
                <field name="warranty_provider"/>
                <field name="warranty_start_date"/>
                <field name="warranty_end_date"/>
                <field name="warranty_active" readonly="1"/>
              </group>
              <group>
                <field name="warranty_notes"/>
              </group>
            </page>

            <page string="Maintenance">
              <field name="maintenance_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="interval_number"/>
                  <field name="interval_type"/>
                  <field name="last_service_date"/>
                  <field name="next_service_date" readonly="1"/>
                  <field name="responsible_id"/>
                  <field name="auto_create_task"/>
                  <field name="active"/>
                </list>
              </field>
            </page>

            <page string="Service History">
              <field name="task_ids" readonly="1">
        <list create="0" edit="0" delete="0"
              decoration-warning="service_status == 'planned'"
              decoration-info="service_status == 'in_progress'"
              decoration-success="service_status == 'done'">
          <field name="name"/>
          <field name="service_status" widget="badge"/>
          <field name="project_id"/>
          <field name="stage_id" invisible="1"/>
          <field name="user_ids" widget="many2many_tags"/>
          <field name="date_deadline"/>
        </list>
      </field>
            </page>

            <page string="Hour Meter">
              <group>
                <field name="hour_meter_current"/>
                <field name="hour_meter_updated_on" readonly="1"/>
              </group>
              <field name="hourmeter_log_ids" readonly="1">
                <list create="0" edit="0" delete="0">
                  <field name="date"/>
                  <field name="reading"/>
                  <field name="task_id"/>
                  <field name="user_id"/>
                  <field name="note"/>
                </list>
              </field>
            </page>

            <page string="Notes">
              <field name="notes"/>
            </page>
          
                        <page string="Attachments">
              <group>
                <button name="action_open_equipment_attachments"
                        type="object"
                        string="Open Attachments"
                        class="oe_highlight"/>
              </group>
              <field name="equipment_attachment_ids" readonly="1">
                <list string="Attachments">
                  <field name="name"/>
                  <field name="create_uid" readonly="1"/>
                  <field name="create_date" readonly="1"/>
                </list>
              </field>
            </page>
</notebook>
        </sheet>
      </form>
    </field>
  </record>
<record id="action_client_equipment" model="ir.actions.act_window">
    <field name="name">Client Equipment</field>
    <field name="res_model">client.equipment</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'group_by': ['partner_id', 'site_contact_id']}</field>

</record>

</odoo>