<odoo>
    <record id="view_ir_attachment_equipment_tree" model="ir.ui.view">
        <field name="name">ir.attachment.equipment.tree</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="Equipment Attachments" create="1" delete="1" edit="1">
                <field name="name"/>
                <field name="mimetype" invisible="1"/>
                <field name="create_uid" readonly="1"/>
                <field name="create_date" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_ir_attachment_equipment_form" model="ir.ui.view">
        <field name="name">ir.attachment.equipment.form</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Equipment Attachment">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="datas" filename="name"/>
                        <field name="mimetype" readonly="1"/>
                        <field name="client_equipment_id" invisible="1"/>
                        <field name="res_model" readonly="1" invisible="1"/>
                        <field name="res_id" readonly="1" invisible="1"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
