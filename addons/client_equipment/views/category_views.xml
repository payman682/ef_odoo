<odoo>
  <record id="view_client_equipment_category_list" model="ir.ui.view">
    <field name="name">client.equipment.category.list</field>
    <field name="model">client.equipment.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_client_equipment_category_form" model="ir.ui.view">
    <field name="name">client.equipment.category.form</field>
    <field name="model">client.equipment.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_client_equipment_category" model="ir.actions.act_window">
    <field name="name">Equipment Categories</field>
    <field name="res_model">client.equipment.category</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active': 1}</field>
  </record>

  </odoo>
