<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show Equipment on Sales Order lines -->
    <record id="view_sale_order_form_inherit_client_equipment" model="ir.ui.view">
        <field name="name">sale.order.form.client.equipment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/*[self::tree or self::list]/field[@name='product_id']" position="after">
                <field name="client_equipment_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Show Equipment on Customer Invoice lines -->
    <record id="view_account_move_form_inherit_client_equipment" model="ir.ui.view">
        <field name="name">account.move.form.client.equipment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/*[self::tree or self::list]/field[@name='product_id']" position="after">
                <field name="client_equipment_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
