<odoo>
    <!-- Module category shown in Users -> Access Rights -->
    <record id="module_category_client_equipment" model="ir.module.category">
        <field name="name">Client Equipment</field>
        <field name="sequence">30</field>
    </record>

    <!-- Odoo 19 uses Privileges to group Access Rights -->
    <record id="privilege_client_equipment" model="res.groups.privilege">
        <field name="name">Client Equipment</field>
        <field name="category_id" ref="module_category_client_equipment"/>
    </record>

    <record id="group_client_equipment_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_client_equipment"/>
    </record>

    <record id="group_client_equipment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_client_equipment"/>
        <field name="implied_ids" eval="[(4, ref('client_equipment.group_client_equipment_user'))]"/>
    </record>

    <!-- Allows closing PM tasks without customer signature (override only) -->
    <record id="group_pm_manager_override" model="res.groups">
        <field name="name">PM Manager Override</field>
        <field name="privilege_id" ref="privilege_client_equipment"/>
        <field name="implied_ids" eval="[(4, ref('client_equipment.group_client_equipment_manager'))]"/>
    </record>
</odoo>
