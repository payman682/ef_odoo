<odoo>
  <record id="ir_cron_client_equipment_pm" model="ir.cron">
    <field name="name">Client Equipment: Generate PM Tasks</field>
    <field name="model_id" ref="model_client_equipment_maintenance"/>
    <field name="state">code</field>
    <field name="code">model._cron_generate_due_tasks()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <!-- Odoo 19 removed numbercall; cron runs forever by default -->
    <field name="active">True</field>
  </record>
</odoo>
